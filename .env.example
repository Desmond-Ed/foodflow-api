PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=foodflow

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=2000

# Set to 1 when behind a single reverse proxy (e.g. Render).
TRUST_PROXY=false

RATE_LIMIT_MAX=100
WEBHOOK_RATE_LIMIT_MAX=1000

LOG_LEVEL=info

NOMINATIM_USER_AGENT=foodflow-api-desmond (yourcontact@email.com)
NOMINATIM_MIN_INTERVAL_MS=1000
NOMINATIM_TIMEOUT_MS=5000

PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx
PAYSTACK_TIMEOUT_MS=10000
